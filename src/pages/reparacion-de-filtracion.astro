---
import SeoServicePage from "../components/SeoServicePage.astro";
import { commonBenefits, commonProcess } from "../data/seoServices";
const faqs = [
  { question: "¿Cómo encuentran el origen de una filtración?", answer: "Revisamos la ubicación de la humedad, las tuberías cercanas, juntas sanitarias y posibles entradas de agua antes de reparar." },
  { question: "¿Pintar la mancha soluciona la filtración?", answer: "No. La pintura puede ocultarla temporalmente, pero primero debe corregirse la causa y dejar secar la superficie." },
  { question: "¿Reparan filtraciones de baños?", answer: "Sí, evaluamos tuberías, desagües, conexiones, sellos y zonas húmedas para identificar el origen." },
  { question: "¿Cuánto demora en secar una pared?", answer: "Depende del material, ventilación y cantidad de humedad. Después de reparar, indicamos recomendaciones para el secado." },
];
---
<SeoServicePage title="Reparación de Filtración en Arequipa | Manantial" description="Reparación de filtraciones de agua en Arequipa. Identificamos el origen de humedad en paredes, pisos, techos y baños. Contacto: 925 384 411." canonical="https://manantialjn.com/reparacion-de-filtracion/" heading="Reparación de Filtración en Arequipa" eyebrow="Control de humedad" intro="Encontramos la causa de la filtración y corregimos el problema para proteger paredes, pisos, techos y acabados de tu propiedad." situationTitle="La humedad visible suele ser solo una señal" situationText="Una mancha puede originarse en una tubería, conexión, desagüe o sello sanitario ubicado lejos del punto visible. Por eso revisamos la causa antes de cerrar o pintar la superficie." signs={["Pintura inflada o desprendida","Manchas que crecen después de usar agua","Moho y olor a humedad","Goteo desde el techo o pared","Humedad junto a baños y cocinas"]} process={commonProcess} benefits={commonBenefits} faqs={faqs} whatsappMessage="Hola, necesito una reparación de filtración en Arequipa." />
