---
import SeoServicePage from "../components/SeoServicePage.astro";
import { commonBenefits, commonProcess } from "../data/seoServices";
const faqs = [
  { question: "¿Qué hago si se rompe una tubería?", answer: "Cierra la llave general de agua, aleja equipos eléctricos de la zona mojada y comunícate con un gasfitero." },
  { question: "¿Se cambia toda la tubería?", answer: "No siempre. Primero evaluamos la extensión del daño para determinar si basta reparar un tramo o si conviene reemplazar una sección mayor." },
  { question: "¿Reparan tuberías dentro de paredes?", answer: "Sí. Identificamos el tramo afectado y procuramos intervenir solo el área necesaria." },
  { question: "¿Atienden roturas imprevistas?", answer: "Sí, ofrecemos atención para emergencias, sujeta a ubicación y disponibilidad." },
];
---
<SeoServicePage title="Tubería Rota | Manantial" description="¿Tienes una tubería rota? Reparamos roturas, uniones y conexiones con fugas en casas y negocios de Arequipa. Atención al 925 384 411." canonical="https://manantialjn.com/tuberia-rota/" heading="Tubería Rota" eyebrow="Intervención profesional" intro="Detenemos la pérdida de agua, evaluamos el tramo dañado y reparamos la tubería para recuperar el funcionamiento de tu instalación." situationTitle="Actúa antes de que el agua cause más daños" situationText="Una tubería rota puede inundar ambientes y afectar pintura, muebles, pisos o instalaciones eléctricas. Cerrar la llave principal y solicitar atención reduce el riesgo mientras llega el técnico." signs={["Salida repentina o continua de agua","Pérdida fuerte de presión","Paredes o pisos que se humedecen rápidamente","Fisuras visibles en tubos o conexiones","Medidor avanzando sin consumo aparente"]} process={commonProcess} benefits={commonBenefits} faqs={faqs} whatsappMessage="Hola, tengo una tubería rota y necesito reparación." />
