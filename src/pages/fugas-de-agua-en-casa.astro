---
import SeoServicePage from "../components/SeoServicePage.astro";
import { commonBenefits, commonProcess } from "../data/seoServices";
const faqs = [
  { question: "¿Cómo saber si tengo una fuga de agua en casa?", answer: "El aumento del recibo, manchas de humedad, sonidos de agua con las llaves cerradas o una caída de presión pueden indicar una fuga." },
  { question: "¿Atienden fugas ocultas?", answer: "Sí. Revisamos tuberías, conexiones, baños, cocinas, paredes y pisos para ubicar el origen del problema." },
  { question: "¿Trabajan en todos los distritos de Arequipa?", answer: "Sí, atendemos viviendas y negocios en Arequipa y zonas cercanas, según disponibilidad." },
  { question: "¿Puedo enviar fotos por WhatsApp?", answer: "Sí. Las fotos o videos ayudan a tener una primera referencia antes de la visita." },
];
---
<SeoServicePage title="Fugas de Agua en Casa | Manantial" description="Solución de fugas de agua en casa en Arequipa. Detectamos el origen y reparamos tuberías, grifos, baños y conexiones. Atención al 925 384 411." canonical="https://manantialjn.com/fugas-de-agua-en-casa/" heading="Fugas de Agua en Casa" eyebrow="Detección y reparación" intro="Localizamos y solucionamos fugas visibles u ocultas antes de que dañen paredes, pisos y muebles o aumenten tu recibo de agua." situationTitle="Una fuga pequeña puede ocasionar daños mayores" situationText="La humedad, el moho y el consumo elevado de agua suelen avanzar si no se corrige su origen. Realizamos una revisión profesional para encontrar la falla y aplicar una reparación adecuada." signs={["Recibo de agua más alto de lo normal","Manchas de humedad en paredes o techos","Piso húmedo sin causa aparente","Sonido de agua con las llaves cerradas","Baja presión en grifos o duchas"]} process={commonProcess} benefits={commonBenefits} faqs={faqs} whatsappMessage="Hola, necesito ayuda con una fuga de agua en casa en Arequipa." />
